# ---------------------------------------------------------------
# 不进 git 的文件。见 docs/11-dev-guide.md 第 4.3 节。
# ---------------------------------------------------------------

# Python 生成的文件和项目专用环境
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# 工具缓存
.ruff_cache/
.pytest_cache/

# 它的"家"：运行数据，见 docs/02-architecture.md 第 8 节
data/

# 密钥：加密的密钥库、主密钥和旧的明文 .env（D36）
.env
secrets.vault
secrets.key

# 用户的个人设定（含个人信息）。仓库里只放模板 identity.example.toml
config/identity.toml

# 编辑器
.vscode/
.idea/

# 用户数据根目录（开发时放在项目里；里面有个人设定和密钥，永远不进 git，见 docs/14-user-data.md）
aureus_home/
/aureus-home.txt

# 本地的个人资料目录，不进 git
thesis/
